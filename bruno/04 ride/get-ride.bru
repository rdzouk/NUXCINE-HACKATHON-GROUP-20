meta {
  name: get ride
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/rides/{{ride_id}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

docs {
  **I1.** Try this with another user's ride id: it answers 404, never 403. A 403 confirms the row exists, which is how an enumeration attack learns which ids are real.

  **I3.** No counterparty phone number appears in any payload, in either direction.
}
