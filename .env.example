# Copy to .env and fill. .env is gitignored and must never be committed.
# Generate every secret with: openssl rand -hex 32
#
# One file serves both halves of the app. That is safe rather than sloppy:
# Vite only exposes variables prefixed VITE_ to the browser bundle, so nothing
# below the frontend section can reach a client even during `npm run build`.
# Keep it that way. A secret that needs to reach the browser is a secret that
# needs a server-side proxy instead (I5).

# ---------------------------------------------------------------- frontend --
# These ARE shipped to the browser. Never put anything sensitive here.

VITE_MAPBOX_TOKEN=
# Point at the API. Locally that is the loopback port below; for a phone on the
# same network or a teammate, use the public tunnel hostname.
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_BASE_URL=ws://localhost:8080/api/v1

# ----------------------------------------------------------------- backend --
# None of this reaches the browser.

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Public base URL the API is reached on. Set to the Cloudflare Tunnel hostname
# once it is known. Used for share links and for CORS reflection checks.
PUBLIC_BASE_URL=http://localhost:8080

# Host port for the API loopback binding. Change it if something already owns
# 8000 on your machine (Splunk uses it, for one).
API_HOST_PORT=8080

POSTGRES_USER=vora
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=vora
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

OSRM_BASE_URL=http://osrm:5000
OSRM_TIMEOUT_S=2.0
# Off until docker/osrm/prepare.sh has built the routing graph. While it is
# off, /health reports osrm as not_configured and quoting uses the labelled
# haversine fallback rather than pretending routing works.
OSRM_ENABLED=false

# Secrets. Distinct key per purpose so that compromise of one does not grant
# the others. Never reuse JWT_SECRET for quote signing.
JWT_SECRET=replace_with_openssl_rand_hex_32
QUOTE_HMAC_SECRET=replace_with_openssl_rand_hex_32
SHARE_TOKEN_SECRET=replace_with_openssl_rand_hex_32
KYC_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32

ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000

# Phone policy. Production allows +237 only.
ALLOWED_COUNTRY_CODES=237
ALLOW_TEST_NUMBERS=true
TEST_NUMBER_PREFIX=+23760000000

# CORS allow-list. Comma separated, never "*".
# 5173 is Vite's dev server; add the tunnel hostname when testing on a phone.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_S=15

# Yaounde and Douala service area, as min_lng,min_lat,max_lng,max_lat.
SERVICE_AREA_BBOX=9.55,3.60,11.75,4.20

# Cloudflare Tunnel.
# Leave both empty for a quick tunnel: a trycloudflare.com hostname is generated
# and printed to the cloudflared service logs.
# For a stable hostname, create a tunnel in the Cloudflare Zero Trust dashboard,
# paste its token here, and set CLOUDFLARE_TUNNEL_ARGS="tunnel run".
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_ARGS=
