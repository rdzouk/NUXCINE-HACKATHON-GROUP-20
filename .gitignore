# Secrets. Never commit .env; .env.example is the documented template.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
design-prototype/node_modules/
design-prototype/dist/

# The routing graph is 223 MB and is regenerated by docker/osrm/prepare.sh, so
# none of it belongs in git. data/landmarks.seed.json IS committed on purpose:
# it is small and it saves every teammate a 223 MB download plus a parse.
osrm-data/
*.osm.pbf
*.osrm*

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Windows alternate-data-stream junk from unzipping on NTFS
*:Zone.Identifier

# Scan output
.gitleaks-report.json
