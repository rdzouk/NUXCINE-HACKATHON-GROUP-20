# OSM and routing data. The Cameroon extract alone is 223 MB and the OSRM
# graph is regenerated by docker/osrm/prepare.sh, so none of it belongs in
# git. data/landmarks.seed.json IS committed on purpose: it is small and it
# saves every teammate a 223 MB download plus a twelve-minute parse.
osrm-data/
*.osm.pbf
*.osrm*

# Editors
.idea/
.vscode/
*.swp
.DS_Store
